# ==============================================================================
# Saasta Scholar Frontend Container (Vite React Build + Nginx Gateway)
# Listens on Port 7865
# ==============================================================================

# Stage 1: Build Static React Frontend Bundle
FROM node:22-alpine AS builder

ARG VITE_SITE_URL=https://saastascholar.durgaaisolutions.in
ARG VITE_SITE_NAME=SaastaScholar
ARG VITE_SITE_DOMAIN=saastascholar.durgaaisolutions.in
ARG VITE_PORT=7865
ARG PORT=7865
ARG HOST=0.0.0.0

ENV VITE_SITE_URL=$VITE_SITE_URL
ENV VITE_SITE_NAME=$VITE_SITE_NAME
ENV VITE_SITE_DOMAIN=$VITE_SITE_DOMAIN
ENV VITE_PORT=$VITE_PORT
ENV PORT=$PORT
ENV HOST=$HOST
ENV NODE_ENV=development
ENV TZ=Asia/Kolkata

WORKDIR /app

RUN apk add --no-cache libc6-compat tzdata
COPY package.json package-lock.json* ./
RUN npm install --include=dev

COPY . .
RUN npm run build

# Stage 2: Production Nginx Runner
FROM nginx:1.26-alpine AS runner

RUN rm -rf /usr/share/nginx/html/* /var/www/html/* /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 7865

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:7865/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
