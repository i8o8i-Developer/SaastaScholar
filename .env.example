# ==============================================================================
# SaastaScholar Production Environment Configuration Template
# Production Domain: saastascholar.durgaaisolutions.in
# Deployment Port: 7865 | Single Container Full-Stack Architecture
# External Relational Database: PostgreSQL 16 (Configured Via Environment)
# In-Container High-Speed Cache: Redis (127.0.0.1:6379)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server, Port & Core Networking Configuration
# ------------------------------------------------------------------------------
PORT=7865
HOST=0.0.0.0
DEBUG=False

# ------------------------------------------------------------------------------
# 2. Portal & Site Domain Metadata
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://saastascholar.durgaaisolutions.in
VITE_SITE_NAME=SaastaScholar
VITE_SITE_DOMAIN=saastascholar.durgaaisolutions.in
VITE_PORT=7865

# ------------------------------------------------------------------------------
# 3. Cryptographic Secret Keys (High-Entropy Production Strings)
# ------------------------------------------------------------------------------
# Generate New Random Keys Via: python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=saastascholar-drm-core-secret-key-2026-prod-9a8f7b6c5d4e3f2a1b
DRM_SIGNING_KEY=saastascholar-drm-forensic-watermark-key-2026-8f7e6d5c4b3a2

# ------------------------------------------------------------------------------
# 4. External PostgreSQL Database Configuration (Remote Provider / Host)
# ------------------------------------------------------------------------------
# Set Your Remote Database Host (E.g. Supabase, Neon, AWS RDS, Hetzner, Or Coolify PG)
POSTGRES_HOST=your-remote-db-host.com
POSTGRES_PORT=5432
POSTGRES_DB=saastascholar_db
POSTGRES_USER=saastascholar_admin
POSTGRES_PASSWORD=YourSecureRemoteDatabasePasswordHere

# Direct PostgreSQL Connection URI (Preferred By Supabase / Neon / Cloud Providers)
# Append ?sslmode=require If Your Cloud Database Provider Mandates SSL Encryption
DATABASE_URL=postgresql://saastascholar_admin:YourSecureRemoteDatabasePasswordHere@your-remote-db-host.com:5432/saastascholar_db

# ------------------------------------------------------------------------------
# 5. In-Container Redis High-Speed Cache & Session Store (Local 127.0.0.1:6379)
# ------------------------------------------------------------------------------
# Managed Automatically Inside The App Container (Zero External Redis Needed)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/1

# ------------------------------------------------------------------------------
# 6. Master Administrator Account Provisioning (Created Automatically On Startup)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@saastascholar.in
ADMIN_PASSWORD=i8o8i@CoreDSPortalSecureSS
ADMIN_NAME=SaastaScholar Administrator
ADMIN_PHONE=+91 9532112801

# ------------------------------------------------------------------------------
# 7. Razorpay Payment Gateway & Webhook Configuration
# ------------------------------------------------------------------------------
# Obtain API Keys From Razorpay Dashboard: Settings -> API Keys (Test / Live Mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Webhook Secret Configured Under Razorpay Dashboard -> Settings -> Webhooks
# Webhook URL: https://saastascholar.durgaaisolutions.in/api/subscriptions/webhook/
# Selected Active Events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# ------------------------------------------------------------------------------
# 8. SigNoz OpenTelemetry Observability & APM Telemetry
# ------------------------------------------------------------------------------
# SigNoz Collector OTLP HTTP Endpoint (Port 4318 For HTTP, Port 4317 For gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://176.31.163.114:4318
OTEL_SERVICE_NAME=saastascholar-app
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.name=saastascholar-app,deployment.environment=production
OTEL_TRACES_SAMPLER=parentbased_always_on

# ------------------------------------------------------------------------------
# 9. Transactional Email Dispatch Configuration (SMTP)
# ------------------------------------------------------------------------------
# For Gmail: Use A 16-Character App Password Generated At https://myaccount.google.com/apppasswords
# For Custom Domain / Zoho / Hostinger: Use Port 587 (TLS) Or Port 465 (SSL)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=durgaaisolutions@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=SaastaScholar Support <support@saastascholar.in>
EMAIL_TIMEOUT=10