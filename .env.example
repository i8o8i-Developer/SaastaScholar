# ==============================================================================
# NimsWallah Production Environment Configuration Template
# Domain: nimswallah.durgaaisolutions.in
# Deployment Port: 7865 | Database Port: 4611
# ==============================================================================

# Server & Networking
PORT=7865
HOST=0.0.0.0
DEBUG=False

# Site & Domain Metadata
VITE_SITE_URL=https://nimswallah.durgaaisolutions.in
VITE_SITE_NAME=NimsWallah
VITE_SITE_DOMAIN=nimswallah.durgaaisolutions.in
VITE_PORT=7865

# Cryptographic Keys
DJANGO_SECRET_KEY=Replace-With-A-Strong-Secret-Key
DRM_SIGNING_KEY=Replace-With-A-Strong-Drm-Key

# High-Security PostgreSQL Database Configuration (Port 4611)
POSTGRES_DB=nimswallah_db
POSTGRES_USER=nimswallah_admin
POSTGRES_PASSWORD=Replace-With-Secure-db-Password
POSTGRES_HOST=postgres_db
POSTGRES_PORT=4611
PGPORT=4611
DATABASE_URL=postgresql://nimswallah_admin:Replace-With-Secure-db-Password@postgres_db:4611/nimswallah_db

# Master Administrator Provisioning (Created On First Startup, Preserved Across Deployments)
ADMIN_EMAIL=admin@nims.edu.in
ADMIN_PASSWORD=replace-with-secure-admin-password
ADMIN_NAME=Institutional Administrator
ADMIN_PHONE=+91 9876543210
