# ==============================================================================
# SaastaScholar Production Environment Configuration Template
# Domain: saastascholar.durgaaisolutions.in
# Deployment Port: 7865 | 2-Container High-Performance Stack
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
PORT=7865
HOST=0.0.0.0
DEBUG=False

# ------------------------------------------------------------------------------
# 2. Site & Domain Metadata
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://saastascholar.durgaaisolutions.in
VITE_SITE_NAME=SaastaScholar
VITE_SITE_DOMAIN=saastascholar.durgaaisolutions.in
VITE_PORT=7865

# ------------------------------------------------------------------------------
# 3. Cryptographic Keys (Minimum 64-Character High-Entropy Strings)
# ------------------------------------------------------------------------------
# Generate via: python -c 'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=saastascholar-drm-core-secret-key-2026-prod-9a8f7b6c5d4e3f2a1b
DRM_SIGNING_KEY=saastascholar-drm-forensic-watermark-key-2026-8f7e6d5c4b3a2

# ------------------------------------------------------------------------------
# 4. PostgreSQL Relational Database Configuration (External Host / Provider)
# ------------------------------------------------------------------------------
# Set your remote/external database host (e.g. Supabase, Neon, Hetzner, AWS RDS, or IP)
POSTGRES_HOST=your-remote-db-host.com
POSTGRES_PORT=5432
POSTGRES_DB=saastascholar_db
POSTGRES_USER=saastascholar_admin
POSTGRES_PASSWORD=YourSecureRemotePasswordHere
# Or supply a full PostgreSQL connection URI directly:
DATABASE_URL=postgresql://saastascholar_admin:YourSecureRemotePasswordHere@your-remote-db-host.com:5432/saastascholar_db

# ------------------------------------------------------------------------------
# 5. In-Container High-Performance Redis Caching Layer (127.0.0.1:6379)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/1

# ------------------------------------------------------------------------------
# 6. Master Administrator Account Provisioning (Created Automatically On Startup)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@saastascholar.in
ADMIN_PASSWORD=i8o8i@CoreDSPortalSecureSS
ADMIN_NAME=SaastaScholar Administrator
ADMIN_PHONE=+91 9532112801

# ------------------------------------------------------------------------------
# 7. Razorpay Payment Gateway & Checkout Configuration
# ------------------------------------------------------------------------------
# Get keys from Razorpay Dashboard: Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_live_YourKeyHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ------------------------------------------------------------------------------
# 8. SigNoz OpenTelemetry Observability & APM Telemetry
# ------------------------------------------------------------------------------
# SigNoz Collector OTLP HTTP Endpoint (Port 4318 for HTTP, Port 4317 for gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://176.31.163.114:4318
OTEL_SERVICE_NAME=saastascholar-app
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.name=saastascholar-app,deployment.environment=production
OTEL_TRACES_SAMPLER=parentbased_always_on

# ------------------------------------------------------------------------------
# 9. Transactional Email Dispatch Configuration (SMTP)
# ------------------------------------------------------------------------------
# For Gmail App Password: https://myaccount.google.com/apppasswords
# For Hostinger / cPanel / Zoho: Use your custom domain SMTP credentials
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=support@saastascholar.in
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=SaastaScholar Support <support@saastascholar.in>
EMAIL_TIMEOUT=10